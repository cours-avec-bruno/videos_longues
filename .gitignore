# Dépendances et caches
node_modules/
.remotion/
.cache/
__pycache__/
.DS_Store
Thumbs.db

# Rendus et exports (médias lourds hors Git, voir docs/journal.md)
out/
**/exports/*
!**/exports/.gitkeep
**/renders/

# Médias lourds
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.wav
*.aif
*.aiff
*.flac
*.exr
*.psd

# Médias des vidéos (vivent sur le PC, hors Git)
**/medias/*
!**/medias/.gitkeep

# Blender : fichiers de scène et sauvegardes automatiques
*.blend
*.blend1
*.blend2

# Secrets
.env
.env.*
